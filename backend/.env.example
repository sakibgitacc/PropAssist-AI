# ==============================================================================
# PROPASSIST AI — ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Duplicate this file as .env in the backend folder and populate your secrets.
# NEVER commit your production .env file to public version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & PRISMA ORM (Integration 1 of 7)
# Official Portal: https://supabase.com/dashboard
# Where to find: Project Settings > Database (for Connection String)
#                Project Settings > API (for Project URL and API Keys)
# Local zero-config default uses SQLite: file:./dev.db
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
# Supabase Production Transaction Pooler (Port 6543):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Supabase Production Direct Migration Connection (Port 5432):
# DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Client Credentials (Used for Supabase Auth and Storage):
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=prop_assist_jwt_super_secure_secret_token_2026_xyz
JWT_REFRESH_SECRET=prop_assist_refresh_super_secure_secret_2026_abc
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. GROQ CLOUD AI ENGINE (Integration 2 of 7)
# Official Portal: https://console.groq.com/keys
# Model: Llama 3.3 70B Versatile for high-speed multilingual grounding
# Safe developer fallback NLP engine activates automatically if key is omitted.
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY (Integration 3 of 7)
# Official Portal: https://dashboard.razorpay.com/#/access/api-keys
# Mode: Test mode or Live merchant credentials
# Safe test mode simulator with verified signatures activates if keys omitted.
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 6. JITSI MEET VIDEO CALLING (Integration 4 of 7)
# Official Portal: https://meet.jit.si
# Free hosted public Jitsi instance or self-hosted deployment.
# Zero paid calling SDKs required.
# ------------------------------------------------------------------------------
JITSI_DOMAIN=meet.jit.si

# ------------------------------------------------------------------------------
# 7. WEBRTC P2P AUDIO CALLING (Integration 5 of 7)
# Official Standard: https://webrtc.org
# Built-in browser-to-browser voice calling via Socket.IO signaling.
# Public Google STUN server (stun:stun.l.google.com:19302) is built in.
# Zero external telecom accounts or paid telephony providers needed.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 8. SOCKET.IO REAL-TIME MESSAGING (Integration 6 of 7)
# Official Documentation: https://socket.io/docs/v4/
# Built-in real-time pipeline running on the Node.js HTTP server.
# Powers in-app chat, unread counters, typing indicators & call signaling.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 9. WHATSAPP CLICK-TO-CHAT (Integration 7 of 7)
# Official Guide: https://faq.whatsapp.com/591339899867296
# Protocol: https://wa.me/
# NO API KEYS, NO META DEVELOPER APPS, NO TOKENS, NO WEBHOOKS REQUIRED.
# Generates dynamic wa.me links with multilingual prefilled templates
# (English, Hindi, Gujarati) and logs WHATSAPP_LINK_OPENED activity.
# ------------------------------------------------------------------------------
