      ]
    },
    {
      "name": "9. Analytics & Audit",
      "item": [
        {
          "name": "GET Dashboard Analytics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/analytics/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analytics", "dashboard"]
            }
          }
        },
        {
          "name": "GET Platform Audit Logs (Super Admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/audit-logs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "audit-logs"]
            }
          }
        }
      ]
    }
  ]
}
