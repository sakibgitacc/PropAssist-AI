            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"+919876543210\",\n  \"message\": \"PropAssist Alert: Site visit scheduled for Sunday at 11:00 AM.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sms/send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sms", "send"]
            }
