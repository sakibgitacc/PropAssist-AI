        {
          "name": "POST Send WhatsApp Template/Message",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"+919876543210\",\n  \"message\": \"Namaste from PropAssist AI! Your show-residence tour pass is confirmed.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/send",
              "host": ["{{baseUrl}}"],
