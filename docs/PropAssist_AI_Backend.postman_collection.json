{
  "info": {
    "name": "PropAssist AI Backend REST API",
    "_postman_id": "propassist-ai-collection-v1",
    "description": "Comprehensive Postman Test Collection for PropAssist AI - Covering all 4 roles (SUPER_ADMIN, SALES_HEAD, SALES_EXECUTIVE, BUYER), data isolation, payments, property booking, allotment, and communication adapters.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. System & Health",
      "item": [
        {
          "name": "GET Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "First Super Admin Setup (One-Time)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"setupSecret\": \"PropAssistInitialAdminSetup2026\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"name\": \"Super Administrator\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/first-super-admin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "first-super-admin"]
            }
          }
        },
        {
          "name": "Register New Buyer",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rajesh Mehta\",\n  \"email\": \"{{buyerEmail}}\",\n  \"password\": \"{{buyerPassword}}\",\n  \"phone\": \"+91 98250 12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login - Super Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.environment.set('authToken', res.token);",
                  "    pm.environment.set('adminToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - Sales Head",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.environment.set('authToken', res.token);",
                  "    pm.environment.set('headToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{headEmail}}\",\n  \"password\": \"{{headPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - Sales Executive A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.environment.set('authToken', res.token);",
                  "    pm.environment.set('execAToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{execEmail}}\",\n  \"password\": \"{{execPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - Buyer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.environment.set('authToken', res.token);",
                  "    pm.environment.set('buyerAToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{buyerEmail}}\",\n  \"password\": \"{{buyerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "GET Auth Profile (/me)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Leads & CRM Management",
      "item": [
        {
          "name": "GET Leads (Role Isolated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/leads?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leads"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "POST Capture Lead (With Deduplication)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rahul Mehta\",\n  \"phone\": \"+91 98980 12345\",\n  \"email\": \"rahul.mehta@example.com\",\n  \"preferredBhk\": \"3 BHK\",\n  \"source\": \"Website Enquiry\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/leads",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leads"]
            }
          }
        },
        {
          "name": "POST Assign Lead to Executive",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"executiveId\": \"{{executiveId}}\",\n  \"reason\": \"High-intent 3 BHK lead assignment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/leads/{{sampleLeadId}}/assign",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leads", "{{sampleLeadId}}", "assign"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Multilingual AI Assistant (Groq)",
      "item": [
        {
          "name": "POST Multilingual Chat (English/Hindi/Gujarati)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What is the starting price for 3 BHK luxury residences in Ahmedabad?\",\n  \"language\": \"en\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ai/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai", "chat"]
            }
          }
        },
        {
          "name": "GET AI Conversations (Role-Filtered)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/ai/conversations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai", "conversations"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Site Visits & Double-Booking Prevention",
      "item": [
        {
          "name": "GET Available Visit Slots",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/slots",
              "host": ["{{baseUrl}}"],
              "path": ["api", "slots"]
            }
          }
        },
        {
          "name": "POST Book Site Visit (Atomic Guard)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\",\n  \"buyerName\": \"Kavita Joshi\",\n  \"buyerPhone\": \"+91 98250 88224\",\n  \"buyerEmail\": \"kavita.joshi@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/slots/book",
              "host": ["{{baseUrl}}"],
              "path": ["api", "slots", "book"]
            }
          }
        },
        {
          "name": "GET Bookings (Buyer isolated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/slots/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "slots", "bookings"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Payments & Verified PDF Receipts",
      "item": [
        {
          "name": "POST Create Razorpay Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50000,\n  \"purpose\": \"Apartment Token Booking Deposit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/order",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "order"]
            }
          }
        },
        {
          "name": "POST Verify Payment Signature",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"order_test_12345\",\n  \"razorpayPaymentId\": \"pay_test_12345\",\n  \"razorpaySignature\": \"sim_sig_order_test_12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "verify"]
            }
          }
        },
        {
          "name": "GET Download Verified PDF Receipt",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/payments/{{paymentId}}/receipt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "{{paymentId}}", "receipt"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Property Bookings & Allotment Letters",
      "item": [
        {
          "name": "POST Reserve Unit (Property Booking)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"unitId\": \"{{unitId}}\",\n  \"tokenAmount\": 100000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/property-bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "property-bookings"]
            }
          }
        },
        {
          "name": "GET Download PDF Allotment Letter",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/property-bookings/{{bookingId}}/allotment-letter",
              "host": ["{{baseUrl}}"],
              "path": ["api", "property-bookings", "{{bookingId}}", "allotment-letter"]
            }
          }
        }
      ]
    },
    {
      "name": "8. Video & Communication Adapters",
      "item": [
        {
          "name": "POST Create Video Consultation Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadId\": \"{{sampleLeadId}}\",\n  \"callType\": \"video\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/calls/create",
              "host": ["{{baseUrl}}"],
